{
  "expo": {
    "name": "Verity Protect",
    "slug": "Verity-Protect",
    "scheme": "verityprotect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexferguson.verityprotect.com",
      "infoPlist": {
        "NSContactsUsageDescription": "Verity Protect uses your contacts to let trusted callers skip the passcode.",
        "NSLocationWhenInUseUsageDescription": "Location lets us find care professionals nearby to add to your trusted list.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Location lets us find care professionals nearby to add to your trusted list."
      }
    },
    "android": {
      "permissions": [
        "READ_CONTACTS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.frontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "verity-protect"
        }
      ]
    ]
  }
}
