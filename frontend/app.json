{
  "expo": {
    "name": "Verity Protect",
    "slug": "Verity-Protect",
    "scheme": "verityprotect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lexferguson.verityprotect.com",
      "infoPlist": {
        "NSContactsUsageDescription": "Verity Protect uses your contacts to let trusted callers skip the passcode.",
        "NSLocationWhenInUseUsageDescription": "Location lets us find care professionals nearby to add to your trusted list.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Location lets us find care professionals nearby to add to your trusted list."
      },
      "appleTeamId": "CAY3N8J725"
    },
    "android": {
      "permissions": [
        "READ_CONTACTS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.frontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/activity-notification.wav",
            "./assets/sounds/support-notification.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3c07d22a-d47c-4729-b40b-f28fc78a5ecc",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "VerityProtectWidgetExtension",
                  "bundleIdentifier": "com.lexferguson.verityprotect.com.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.lexferguson.verityprotect.com"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "synastrr"
  }
}
