# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_SECRET=your-twilio-webhook-secret
TWILIO_VALIDATE_SIGNATURE=false
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret
TWILIO_CLIENT_TOKEN_TTL=3600
TWILIO_CLIENT_SESSION_TTL=14400
TWILIO_CLIENT_STALE_NOTIFY_COOLDOWN_SECONDS=86400

# Azure Speech-to-Text
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralus

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Application
NODE_ENV=development
PORT=3000
JWT_SECRET=your-secret-key-change-in-production
SESSION_SECRET=your-session-secret-change-in-production

# Call bridging (feature flag)
ENABLE_CALL_BRIDGE=false
# VoIP cold/warm start tuning (seconds)
VOIP_PUSH_WARM_START_PAUSE_SECONDS=1
VOIP_PUSH_COLD_START_PAUSE_SECONDS=6
TWILIO_CLIENT_FRESH_SECONDS=60
TWILIO_CLIENT_DIAL_TIMEOUT_SECONDS=12
TWILIO_CLIENT_DIAL_TIMEOUT_WARM_SECONDS=16
TWILIO_CLIENT_DIAL_TIMEOUT_COLD_SECONDS=24

# Voice (optional dev override)
OUTBOUND_CALLER_ID=+15551234567

# Fraud detection
FRAUD_SCORE_THRESHOLD=90

# Call blocking (feature flag)
ENABLE_CALL_BLOCKING=false

# Logging
LOG_LEVEL=debug

# CORS
# Comma-separated allowlist. Supports * wildcard segments.
# Examples: https://app.example.com,https://*.example.com,exp://localhost:*
CORS_ORIGIN=exp://localhost:*,http://localhost:3000

# Internal ops/test route protection
# Required in production for /sentry-test and /admin protected endpoints.
INTERNAL_OPS_KEY=
ENABLE_SENTRY_TEST_ROUTES=false

# Legal docs (source of truth for signup acceptance metadata)
LEGAL_TERMS_VERSION=2026-02-20
LEGAL_PRIVACY_VERSION=2026-02-20
LEGAL_TERMS_URL=https://www.verityprotect.com/terms
LEGAL_PRIVACY_URL=https://www.verityprotect.com/privacy

# Retention cleanup scheduler
ENABLE_RETENTION_CLEANUP=false
# Backward-compat alias (either flag enables cleanup):
ALLOW_RETENTION_PRUNE=false
RETENTION_DAYS=90
# Safety default is true; set false only when ready to perform deletes.
RETENTION_CLEANUP_DRY_RUN=true
RETENTION_CLEANUP_INTERVAL_MINUTES=360
RETENTION_CLEANUP_STARTUP_DELAY_SECONDS=45

# Trial lifecycle cleanup scheduler (number reclaim + delayed data purge)
ENABLE_TRIAL_LIFECYCLE_CLEANUP=false
# Safety default is true; set false to allow reclaim/purge writes.
TRIAL_LIFECYCLE_DRY_RUN=true
TRIAL_RECLAIM_GRACE_HOURS=24
TRIAL_DATA_RETENTION_DAYS=30
TRIAL_LIFECYCLE_INTERVAL_MINUTES=60
TRIAL_LIFECYCLE_STARTUP_DELAY_SECONDS=90

# Trial reminder push scheduler (nurture + conversion nudges)
ENABLE_TRIAL_REMINDER_PUSH=true
# Safety default is true; set false to deliver reminder pushes.
TRIAL_REMINDER_PUSH_DRY_RUN=true
TRIAL_REMINDER_PUSH_INTERVAL_MINUTES=120
TRIAL_REMINDER_PUSH_STARTUP_DELAY_SECONDS=120



APPLE_SHARED_SECRET=secret token
# Comma-separated subscription product ids allowed for membership activation.
APPLE_SUBSCRIPTION_PRODUCT_IDS=verityprotect_monthly,verityprotect_annual

# App Store Server API (recommended production path for transaction validation)
APPLE_APP_STORE_ISSUER_ID=
APPLE_APP_STORE_KEY_ID=
APPLE_APP_STORE_BUNDLE_ID=
# Provide PEM text (escaped newlines) or base64-encoded PEM.
APPLE_APP_STORE_PRIVATE_KEY=
