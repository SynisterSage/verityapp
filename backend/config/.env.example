## Environment ##
NODE_ENV=development

## Server ##
PORT=4000
HOST=localhost
# Public URL accessible to Twilio/webhooks (leave empty when deriving from request).
PUBLIC_API_URL=http://localhost:4000

## Setup jet-logger ##
JET_LOGGER_MODE=CONSOLE
JET_LOGGER_FILEPATH=jet-logger.log
JET_LOGGER_TIMESTAMP=TRUE
JET_LOGGER_FORMAT=LINE

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_SECRET=your-twilio-webhook-secret
TWILIO_VALIDATE_SIGNATURE=false

# Azure Speech-to-Text
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=centralus

# Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Call bridging (feature flag)
ENABLE_CALL_BRIDGE=false

# Voice (optional dev override)
OUTBOUND_CALLER_ID=+15551234567

# Fraud detection
FRAUD_SCORE_THRESHOLD=90

# Call blocking (feature flag)
ENABLE_CALL_BLOCKING=false

RETENTION_DAYS=90
ALLOW_RETENTION_PRUNE=false

# APNs VoIP Push Notifications (iOS)
# Required for waking the iOS app from killed state for incoming calls
# Local dev: Use APNS_AUTH_KEY_PATH to point to .p8 file
# Production/Render: Use APNS_AUTH_KEY with the full key content (including BEGIN/END lines)
APNS_AUTH_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APNS_AUTH_KEY=
APNS_AUTH_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
IOS_BUNDLE_IDENTIFIER=com.lexferguson.verityprotect.com
APNS_PRODUCTION=false
